# Keycloak server config — consumed by the `keycloak` container only.
# `npm run setup` copies this to .env.

# KEYCLOAK_ADMIN/_PASSWORD are deprecated in KC 26 -> KC_BOOTSTRAP_ADMIN_*
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=admin

KC_HTTP_ENABLED=true
KC_HEALTH_ENABLED=true
KC_HOSTNAME_STRICT=false

# JVM heap cap — RAM budget is tight (PLAN.md §5)
JAVA_OPTS_KC_HEAP=-Xms256m -Xmx512m
