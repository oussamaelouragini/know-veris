# Ollama server config — consumed by the `ollama` container only.
# `npm run setup` copies this to .env. Client-side model names and CPU tuning
# live in apps/api/.env.

# Keep models warm across a session so back-to-back questions skip the reload
OLLAMA_KEEP_ALIVE=30m

OLLAMA_NUM_PARALLEL=1

# 2 = keep bge-m3 (embed) and the generation model resident together, so a
# single chat request (embed -> generate) never evicts one to load the other
# (cold prefill on every call otherwise). PLAN §5 RAM budget already assumes
# both are resident (~1.2 GB + ~3 GB).
OLLAMA_MAX_LOADED_MODELS=2
