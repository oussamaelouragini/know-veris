# Root build context (used by apps/web/Dockerfile). apps/api has its own.
.git/
.github/
.gitignore
.gitattributes
.nx/
.claude/
.vscode/
.idea/
node_modules/
**/node_modules/
**/dist/
**/.venv/
**/__pycache__/
**/.pytest_cache/
**/.ruff_cache/
**/.mypy_cache/
