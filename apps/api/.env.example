# KnowVeris API — environment template. `npm run setup` copies this to .env.
# Never commit .env. Read via Pydantic Settings (app/core/config.py).
#
# This file is the *only* env source for the api container (docker-compose
# `env_file`). Postgres/Keycloak/Ollama server-side config lives under infra/.

# --- Database ---
# Host "postgres" = the compose service name. Credentials must match
# infra/postgres/.env.
DATABASE_URL=postgresql+asyncpg://knowveris:knowveris@postgres:5432/knowveris
# pytest uses a separate database (see tests/conftest.py) so it never collides
# with the dev data. Override the default target only if needed:
# TEST_DATABASE_URL=postgresql+asyncpg://knowveris:knowveris@postgres:5432/knowveris_test

# --- Keycloak ---
KEYCLOAK_REALM=knowveris
# Issuer as seen from the browser AND from the API container. Keeping a single
# hostname avoids the classic "token issuer mismatch" between SPA and backend.
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_INTERNAL_URL=http://keycloak:8080
KEYCLOAK_ISSUER=http://localhost:8080/realms/knowveris
KEYCLOAK_JWKS_URL=http://keycloak:8080/realms/knowveris/protocol/openid-connect/certs
# Audience validated by FastAPI
KEYCLOAK_AUDIENCE=knowveris-api
# Confidential service account used for the Admin REST API (ADR-006)
KEYCLOAK_ADMIN_CLIENT_ID=knowveris-admin-cli
KEYCLOAK_ADMIN_CLIENT_SECRET=change-me-in-local-env

# --- Ollama (client side; server tuning lives in infra/ollama/.env) ---
OLLAMA_URL=http://ollama:11434
OLLAMA_GENERATION_MODEL=qwen3:4b-instruct-2507-q4_K_M
OLLAMA_FALLBACK_MODEL=qwen3:1.7b
OLLAMA_EMBEDDING_MODEL=bge-m3
# CPU-only tuning (PLAN.md §5): 8 Zen 2 cores, no SMT
OLLAMA_NUM_THREAD=8
OLLAMA_NUM_CTX=4096
# Max generated tokens: -1 = unlimited (off). Set ~256 in Week 2 to bound latency, measured on the golden set.
OLLAMA_NUM_PREDICT=-1

# --- RAG pipeline (CPU-constrained defaults, see docs.md) ---
CHUNK_SIZE=500
CHUNK_OVERLAP=80
RETRIEVAL_TOP_K=20
RERANK_TOP_K=3
# Guardrail 1: refuse before calling the LLM below this score. Calibrated in week 2.
RELEVANCE_THRESHOLD=0.50
RERANKER_ENABLED=false
RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# --- API ---
API_CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO
STORAGE_PATH=/app/storage
