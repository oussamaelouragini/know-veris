{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "api",
  "projectType": "application",
  "sourceRoot": "apps/api/app",
  "tags": ["scope:api", "lang:python"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "docker compose build api"
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": "docker compose up -d api"
      }
    },
    "logs": {
      "executor": "nx:run-commands",
      "options": {
        "command": "docker compose logs -f api"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "docker compose exec -T api pytest"
      }
    },
    "test-eval": {
      "executor": "nx:run-commands",
      "options": {
        "command": "docker compose exec -T api pytest tests/eval -m eval -v"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "docker compose exec -T api ruff check ."
      }
    },
    "format": {
      "executor": "nx:run-commands",
      "options": {
        "command": "docker compose exec -T api sh -c \"ruff check --fix . && ruff format .\""
      }
    },
    "migrate": {
      "executor": "nx:run-commands",
      "options": {
        "command": "docker compose exec -T api alembic upgrade head"
      }
    },
    "migration": {
      "executor": "nx:run-commands",
      "options": {
        "command": "docker compose exec -T api alembic revision --autogenerate -m \"{args.message}\""
      }
    },
    "lock": {
      "executor": "nx:run-commands",
      "options": {
        "command": "docker compose run --rm --no-deps --entrypoint sh api -c \"poetry lock\""
      }
    },
    "shell": {
      "executor": "nx:run-commands",
      "options": {
        "command": "docker compose exec api bash"
      }
    }
  }
}
