# KnowVeris web — environment template. `npm run setup` copies this to .env.
#
# One file, two readers: docker-compose passes it to the `web` container via
# `env_file`, and Vite loads it natively (envDir defaults to this project root).
VITE_API_URL=http://localhost:8000
VITE_KEYCLOAK_URL=http://localhost:8080
VITE_KEYCLOAK_REALM=knowveris
VITE_KEYCLOAK_CLIENT_ID=knowveris-web
