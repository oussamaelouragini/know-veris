{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "web",
  "projectType": "application",
  "sourceRoot": "apps/web/src",
  "tags": ["scope:web", "lang:ts"],
  "implicitDependencies": ["api"],
  "targets": {
    "docker-build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "docker compose build web"
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": "docker compose up -d web"
      }
    },
    "logs": {
      "executor": "nx:run-commands",
      "options": {
        "command": "docker compose logs -f web"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "docker compose exec -T web npm run build"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "docker compose exec -T web npx tsc -b"
      }
    },
    "install": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "docker compose exec -T web npm install",
          "docker compose restart web"
        ],
        "parallel": false
      }
    },
    "shell": {
      "executor": "nx:run-commands",
      "options": {
        "command": "docker compose exec web sh"
      }
    }
  }
}
